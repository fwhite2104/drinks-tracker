[Desktop Entry]
# Install: copy to ~/.local/share/applications/ and set Path= to this repo root.
# Exec assumes .venv exists in Path= and run_dashboard.py is at the repo root.
Name=Pourpoint Operator Dashboard
Comment=Local read-only Admin Dashboard for the Irish beverage price feed
Exec=sh -c 'exec .venv/bin/python run_dashboard.py'
Path=/path/to/drinks-tracker
Icon=utilities-system-monitor
Type=Application
Terminal=true
Categories=Development;
StartupNotify=true
