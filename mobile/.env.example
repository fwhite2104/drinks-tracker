# Drinks Tracker — API base URL
#
# The app reads the API base URL at BUILD TIME from EXPO_PUBLIC_API_BASE_URL
# (spec §8: "App talks to the deployed public API via a build-time base URL;
# dev builds hit the LAN"). `expo start` picks it up from this file; EAS builds
# take it from the matching profile's `env` in eas.json.

# ── Development: the LAN API (beverage-feed `docker compose up api`) ──
# Replace with your machine's LAN IP; localhost only works on the same device.
# NOTE: plain-HTTP LAN URLs work in Expo Go; a dedicated Android dev build
# needs `expo-build-properties` with `android.usesCleartextTraffic: true`.
EXPO_PUBLIC_API_BASE_URL=http://192.168.50.123:8000

# ── Production: the deployed public API (ticket 10/15 — placeholder) ──
# The real domain lands with the Cloudflare Tunnel deployment; the
# `production` profile in eas.json must be updated with it.
# EXPO_PUBLIC_API_BASE_URL=https://api.<your-domain>
